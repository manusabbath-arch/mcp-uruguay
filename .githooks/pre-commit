#!/bin/sh
# El hook se instala desde main: también alcanza ramas anteriores sin el script.
set -eu
base=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# Los ejecutables nativos de Windows necesitan una ruta nativa, aun con MSYS_NO_PATHCONV.
if command -v cygpath >/dev/null 2>&1; then
    base=$(cygpath -m "$base")
fi
exec uv run --quiet --no-project python -X utf8 "$base/scripts/sesiones.py" comprobar
